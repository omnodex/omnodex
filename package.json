{
  "name": "omnodex",
  "version": "0.1.0",
  "private": true,
  "description": "Security and observability for AI agent execution.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnodex/omnodex.git"
  },
  "homepage": "https://omnodex.com",
  "bugs": {
    "url": "https://github.com/omnodex/omnodex/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "spike": "npm run build --workspaces --if-present && node --test packages/*/test/**/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
