{
  "name": "@omnodex/sync-encryptor",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end encrypted sync for the Omnodex hosted dashboard. Derives keys client-side via Argon2id; encrypts projection data with AES-256-GCM; pushes ciphertext to cloud. The server never sees the passphrase or an unwrapped key.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sync-runner": {
      "import": "./dist/sync-runner.js",
      "types": "./dist/sync-runner.d.ts"
    },
    "./hpke-event": {
      "import": "./dist/hpke-event.js",
      "types": "./dist/hpke-event.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/rm.mjs dist tsconfig.tsbuildinfo",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@omnodex/event-log": "*",
    "@omnodex/license-client": "*",
    "@omnodex/projection": "*",
    "@omnodex/shared": "*",
    "hash-wasm": "^4.11.0"
  }
}
