{
  "name": "@omnodex/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command line interface for Omnodex. Runs the full pipeline end to end.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "omnodex": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b && cp src/dashboard.html dist/dashboard.html",
    "bundle": "npm run build && node bundle.config.mjs",
    "clean": "rm -rf dist bundle/omnodex-bundle.cjs bundle/omnodex.cjs bundle/dashboard.html",
    "start": "node dist/index.js",
    "spike": "node dist/index.js spike",
    "dashboard": "node dist/index.js dashboard",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@omnodex/analyzer": "*",
    "@omnodex/antigravity-provider": "*",
    "@omnodex/codex-provider": "*",
    "@omnodex/event-log": "*",
    "@omnodex/hooks-provider": "*",
    "@omnodex/license-client": "*",
    "@omnodex/mcp-proxy": "*",
    "@omnodex/projection": "*",
    "@omnodex/shared": "*",
    "@omnodex/sync-encryptor": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
