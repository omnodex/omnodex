{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@omnodex/analyzer": ["./analyzer-browser.ts"],
      "@omnodex/shared": ["../../../shared/src/index.ts"],
      "@omnodex/projection": ["../../../projection/src/index.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./css.d.ts", "../dashboard-model/**/*.ts"]
}
