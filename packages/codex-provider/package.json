{
  "name": "@omnodex/codex-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Omnodex interceptor for OpenAI Codex (CLI and desktop app) via the Codex hooks system.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "test": "node --test test/**/*.test.mjs"
  },
  "bin": {
    "omnodex-codex-hook": "./dist/bin/codex-hook-shim.js"
  },
  "dependencies": {
    "@omnodex/shared": "*",
    "@omnodex/event-log": "*"
  }
}
