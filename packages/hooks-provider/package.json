{
  "name": "@omnodex/hooks-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Interceptor implementations. Ships a Claude Code hook provider and a mock session generator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "npm run build && node bundle.config.mjs",
    "clean": "rm -rf dist bundle",
    "test": "node --test test/**/*.test.mjs"
  },
  "bin": {
    "omnodex-claude-hook": "./dist/bin/claude-hook-shim.js"
  },
  "dependencies": {
    "@omnodex/analyzer": "*",
    "@omnodex/event-log": "*",
    "@omnodex/shared": "*",
    "@omnodex/sync-encryptor": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
